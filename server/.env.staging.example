# ==============================================================================
# Stech WhatsApp Business CRM — Staging Environment Configuration Template
# Branch: feature/phase-7-production-readiness
# Target: Single Ubuntu Linux VPS with TLS Reverse Proxy
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=https://staging.yourdomain.com
ALLOWED_ORIGINS=https://staging.yourdomain.com

# PostgreSQL Credentials & Connection (Private Docker internal network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_STAGING_DB_PASSWORD
POSTGRES_DB=whatsapp_crm
DATABASE_URL="postgresql://postgres:REPLACE_WITH_STRONG_STAGING_DB_PASSWORD@postgres:5432/whatsapp_crm?schema=public"

# Authentication & Session Security (MANDATORY: Minimum 32 cryptographically random chars)
JWT_SECRET=REPLACE_WITH_GENUINE_64_CHAR_HEX_OR_BASE64_RANDOM_SECRET
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Meta WhatsApp Cloud API — STAGING SAFEGUARD:
# Keep WHATSAPP_MODE=mock and CAMPAIGN_WORKER_ENABLED=false to strictly prevent real WhatsApp bulk dispatching!
WHATSAPP_ENABLED=true
WHATSAPP_MODE=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_APP_ID=mock_meta_app_id
WHATSAPP_APP_SECRET=mock_meta_app_secret
WHATSAPP_ACCESS_TOKEN=mock_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=mock_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=mock_meta_waba_id
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_STAGING_WEBHOOK_VERIFY_TOKEN
WHATSAPP_WEBHOOK_PATH=/api/v1/webhooks/whatsapp

# Background Campaign Worker & Throttling
# Set to false for web-only staging or true in mock mode
CAMPAIGN_WORKER_ENABLED=false
CAMPAIGN_RATE_LIMIT_DELAY_MS=100
CAMPAIGN_BATCH_SIZE=10
CAMPAIGN_MAX_RETRIES=3

# Observability & Logging
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=3000
