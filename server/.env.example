# ==============================================================================
# Stech WhatsApp Business CRM — Server Environment Configuration Template
# Copy to .env for local development. Never commit live production secrets to Git.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_crm?schema=public"

# Authentication & Session Security (Minimum 32 random characters for JWT_SECRET)
JWT_SECRET=development_jwt_secret_must_be_over_32_characters_long
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# API Rate Limiting (15 minutes window, 500 requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Meta WhatsApp Cloud API Integration
WHATSAPP_ENABLED=true
WHATSAPP_MODE=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_APP_ID=your_meta_app_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_WEBHOOK_PATH=/api/v1/webhooks/whatsapp

# Background Campaign Worker & Throttling
CAMPAIGN_WORKER_ENABLED=true
CAMPAIGN_RATE_LIMIT_DELAY_MS=50
CAMPAIGN_BATCH_SIZE=10
CAMPAIGN_MAX_RETRIES=3

# Observability & Monitoring
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=3000
