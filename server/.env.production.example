# ==============================================================================
# Stech WhatsApp Business CRM — Production Environment Configuration Template
# For Staging/Production deployments. Deploy via secret manager or secure CI/CD.
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=https://crm.yourcompany.com
ALLOWED_ORIGINS=https://crm.yourcompany.com

# PostgreSQL Credentials & Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=whatsapp_crm
DATABASE_URL="postgresql://postgres:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/whatsapp_crm?schema=public"

# Authentication & Session Security (MANDATORY: Minimum 32 cryptographically random chars)
JWT_SECRET=REPLACE_WITH_GENUINE_64_CHAR_HEX_OR_BASE64_RANDOM_SECRET
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# API Rate Limiting (Stricter in production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Meta WhatsApp Cloud API (Live Production Credentials)
WHATSAPP_ENABLED=true
WHATSAPP_MODE=production
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_APP_ID=REPLACE_WITH_LIVE_META_APP_ID
WHATSAPP_APP_SECRET=REPLACE_WITH_LIVE_META_APP_SECRET
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_PERMANENT_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_META_WABA_ID
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_SECURE_RANDOM_WEBHOOK_VERIFY_TOKEN
WHATSAPP_WEBHOOK_PATH=/api/v1/webhooks/whatsapp

# Background Campaign Worker & Throttling (Meta Tier-1 compliant throughput)
CAMPAIGN_WORKER_ENABLED=true
CAMPAIGN_RATE_LIMIT_DELAY_MS=100
CAMPAIGN_BATCH_SIZE=20
CAMPAIGN_MAX_RETRIES=3

# Observability & Logging
LOG_LEVEL=warn
HEALTH_CHECK_TIMEOUT_MS=3000
