# ==============================================================================
# Stech WhatsApp Business CRM — Free Cloud Deployment Environment Configuration
# Target: Oracle Cloud Infrastructure Always Free / Cloudflare Quick Tunnel
# Mandatory: $0.00 / month | Strict Safety Invariants
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=https://your-free-subdomain-or-tunnel.trycloudflare.com
ALLOWED_ORIGINS=https://your-free-subdomain-or-tunnel.trycloudflare.com

# PostgreSQL Credentials & Connection (Private Docker Internal Network: postgres:5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_FREE_TIER_PASSWORD
POSTGRES_DB=whatsapp_crm
DATABASE_URL="postgresql://postgres:REPLACE_WITH_STRONG_FREE_TIER_PASSWORD@postgres:5432/whatsapp_crm?schema=public"

# Authentication & Session Security (MANDATORY: Minimum 32 cryptographically random chars)
JWT_SECRET=REPLACE_WITH_GENUINE_64_CHAR_HEX_OR_BASE64_RANDOM_SECRET
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# API Rate Limiting (Free tier safe)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Meta WhatsApp Cloud API — FREE STAGING SAFEGUARDS:
# Always keep WHATSAPP_MODE=mock and CAMPAIGN_WORKER_ENABLED=false to guarantee zero accidental Meta charges or message dispatch!
WHATSAPP_ENABLED=true
WHATSAPP_MODE=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_APP_ID=free_tier_mock_app_id
WHATSAPP_APP_SECRET=free_tier_mock_app_secret
WHATSAPP_ACCESS_TOKEN=free_tier_mock_access_token
WHATSAPP_PHONE_NUMBER_ID=free_tier_mock_phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=free_tier_mock_waba_id
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_FREE_TIER_WEBHOOK_VERIFY_TOKEN
WHATSAPP_WEBHOOK_PATH=/api/v1/webhooks/whatsapp

# Background Campaign Worker & Throttling
# Disabled by default on free tier to conserve CPU and prevent uncontrolled message loops
CAMPAIGN_WORKER_ENABLED=false
CAMPAIGN_RATE_LIMIT_DELAY_MS=100
CAMPAIGN_BATCH_SIZE=10
CAMPAIGN_MAX_RETRIES=3

# Observability & Logging
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=3000
